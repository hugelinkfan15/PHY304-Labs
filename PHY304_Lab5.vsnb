  {
   "kind": 2,
   "value": "Module[{dir = FileNameJoin[{NotebookDirectory[], \"img\"}], plot1, plot2, cylinder, paths},\n  If[!DirectoryQ[dir], CreateDirectory[dir]];\n  plot1 = Plot[x, {x, 0, 5}];\n  plot2 = Module[{g = 9.8, l = 10, sol, phi, t},\n    sol = NDSolve[{phi''[t] == -(g/l) Sin[phi[t]], phi[0] == 0, phi'[0] == Pi/6}, phi, {t, 0, 10}];\n    Plot[Evaluate[phi[t] /. First[sol]], {t, 0, 10}]\n  ];\n  cylinder = Graphics3D[{Gray, Cylinder[{{0, 0, 0}, {0, 0, 2}}, 0.05], Yellow, Cylinder[{{0, -0.1, 0}, {0, 0.1, 0}}, 1/2]}];\n  paths = FileNameJoin[{dir, #}] & /@ {\"plot1.png\", \"plot2.png\", \"cylinder.png\"};\n  Export[paths[[1]], plot1];\n  Export[paths[[2]], plot2];\n  Export[paths[[3]], cylinder];\n  Grid[{{\"Graphic\", \"PNG file\"}, {\"Plot 1\", paths[[1]]}, {\"Plot 2\", paths[[2]]}, {\"Cylinder\", paths[[3]]}}, Frame -> All, Alignment -> Left]\n]",
   "languageId": "wolfram",
   "outputs": [
